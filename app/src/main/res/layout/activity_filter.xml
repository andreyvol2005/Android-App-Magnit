<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E63946">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ФИЛЬТРЫ"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>

        <!-- Карточка с категориями с автоматическим переносом -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Категория"
                    android:textColor="#E63946"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap"
                    app:alignItems="stretch"
                    app:alignContent="flex_start"
                    app:flexDirection="row"
                    app:justifyContent="flex_start">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Все"
                        android:checked="true"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryAlcohol"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Алкоголь"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryReadyMeal"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Готовая еда"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryDairy"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Молочный прилавок"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryFruitsVeg"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Овощи и фрукты"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryBakery"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Хлеб и выпечка" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryGrocery"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Бакалея"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryCanned"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Консервы" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryMeatPoultry"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Птица, мясо"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryFish"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Рыба, морепродукты"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryFrozen"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Заморозка" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categorySweets"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Сладости" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categorySnacks"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Снеки"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryTeaCoffee"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Чай, кофе, какао"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryDrinks"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Вода и напитки"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryKids"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Для детей"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryPets"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Для животных" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryHygiene"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Гигиена и уход"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryHome"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Для дома и не только" />

                </com.google.android.flexbox.FlexboxLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Карточка с ценой -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Цена"
                    android:textColor="#E63946"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/priceRangeMin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 ₽"
                        android:textColor="#333333"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:layout_marginHorizontal="8dp" />

                    <TextView
                        android:id="@+id/priceRangeMax"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="5000 ₽"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textAlignment="textEnd" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/priceSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10000"
                    android:progress="5000"
                    android:progressTint="#E63946"
                    android:thumbTint="#E63946" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Рейтинг и отзывы в одной строке -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Карточка с рейтингом -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Рейтинг"
                        android:textColor="#E63946"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <RadioGroup
                        android:id="@+id/ratingRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/ratingAny"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Любой"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rating4Plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.0 и выше"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rating4_5Plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.5 и выше"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rating4_8Plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.8 и выше"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rating5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5.0"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                    </RadioGroup>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Карточка с количеством отзывов -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Отзывы"
                        android:textColor="#E63946"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <RadioGroup
                        android:id="@+id/reviewsRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/reviewsAny"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Любое"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/reviews10Plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 и более"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/reviews50Plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50 и более"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/reviews100Plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100 и более"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/reviews500Plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="500 и более"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                    </RadioGroup>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Кнопки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Сбросить"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/rounded_button"
                app:cardBackgroundColor="#D32F3F"/>

            <Button
                android:id="@+id/applyButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Применить"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#FF5C6B"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>